{
  "name": "@asterism-plugins/apply-patch",
  "version": "0.1.0",
  "type": "module",
  "description": "Apply Codex-format text patches to a linked Asterism Directory.",
  "files": ["dist", "README.md", "locales"],
  "dependencies": { "diff": "9.0.0" },
  "peerDependencies": {
    "@asterism-app/builtin-api": "*",
    "@asterism-app/sdk": "*",
    "react": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": { "@types/react": "^19.2.0" },
  "scripts": {
    "build": "asterism-plugin-build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/*.test.ts",
    "prepack": "npm run build"
  },
  "asterism": {
    "id": "asterism.apply-patch",
    "displayName": { "owner": "asterism.apply-patch", "id": "plugin.displayName", "defaultMessage": "Apply Patch", "kind": "message", "sourceLocale": "en" },
    "description": { "owner": "asterism.apply-patch", "id": "plugin.description", "defaultMessage": "Apply Codex-format patches to a linked Directory.", "kind": "message", "sourceLocale": "en" },
    "build": { "runtime": "src/runtime.ts", "renderer": "src/renderer.ts" },
    "i18n": { "catalogs": { "zh-Hans": "locales/zh-Hans.json" } }
  },
  "license": "MIT"
}
